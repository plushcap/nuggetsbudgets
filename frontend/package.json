    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "npm run type-check && vite build",
    "check:build": "node scripts/check-build.mjs",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:guard": "node scripts/check-idiom-a.mjs",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,md}'",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "homepage": "https://github.com/plushcap/nuggetsbudgets#readme",
  "bugs": {
    "url": "https://github.com/plushcap/nuggetsbudgets/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plushcap/nuggetsbudgets.git",
    "directory": "frontend"
  },
  "engines": {
    "node": ">=26"
  }
}

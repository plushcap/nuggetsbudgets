  "type": "module",
  "private": true,
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@nivo/sankey": "^0.99.0",
    "@nivo/treemap": "^0.99.0",
    "@nuggets/shared": "file:../shared",
    "@radix-ui/themes": "^3.2.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.107.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.70.0",
    "lucide-static": "^1.70.0",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",

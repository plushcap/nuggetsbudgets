<mj-button
  background-color="#2563eb"
  color="#ffffff"
  font-size="16px"
  font-weight="600"
  border-radius="8px"
  padding="15px 30px"
  align="center"
  href="{{buttonUrl}}"
  font-family="'Atkinson Hyperlegible', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
>
  {{buttonText}}
</mj-button>

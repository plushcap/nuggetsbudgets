{
  "name": "nuggets-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nuggets backend: the REST API, schedulers and MCP host of a self-hosted family finance manager",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
    "docs:env": "tsc -p tsconfig.build.json && node dist/scripts/env-docs.js",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --project migrations",
    "test:migrations": "vitest run --project migrations",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "eslint 'src/**/*.ts' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.ts' --fix --max-warnings 0",
    "db:codegen": "kysely-codegen --url \"$DATABASE_URL\" --dialect postgres --date-parser string --out-file src/db/schema.generated.ts",
    "db:codegen:check": "kysely-codegen --url \"$DATABASE_URL\" --dialect postgres --date-parser string --out-file src/db/schema.generated.ts && git diff --exit-code -- src/db/schema.generated.ts",
    "migrate": "node dist/scripts/migrate.js migrate",
    "migrate:status": "node dist/scripts/migrate.js status",
    "migrate:rollback": "node dist/scripts/migrate.js rollback",
    "migrate:create": "node dist/scripts/migrate.js create",
    "images:migrate": "node dist/scripts/migrate-images-to-db.js",
    "setup-token": "node dist/scripts/setup-token.js",
    "secrets:rewrap": "node dist/scripts/rewrap-secrets.js"
  },
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@nuggets/shared": "file:../shared",
    "@simplewebauthn/server": "^14.1.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "isomorphic-fetch": "^3.0.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.8",
    "mjml": "^5.4.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.0",
    "nuggets-mcp": "file:../mcp",
    "opossum": "^10.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "web-push": "^4.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.6",
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mjml": "^5.4.2",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.13.0",
    "globals": "^17.14.0",
    "kysely-codegen": "^0.20.0",
    "supertest": "^7.3.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "finance",
    "budget",
    "express",
    "typescript",
    "postgresql"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/plushcap/nuggetsbudgets#readme",
  "bugs": {
    "url": "https://github.com/plushcap/nuggetsbudgets/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plushcap/nuggetsbudgets.git",
    "directory": "backend"
  },
  "engines": {
    "node": ">=26"
  }
}

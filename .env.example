# Nuggets — local DEVELOPMENT environment template.
#
# Copy to .env (`cp .env.example .env`, or run `npm run setup`) and adjust.
# NEVER commit your real .env.
#
# Secrets (DB password, JWT, session, CSRF, backup key, SMTP, SimpleFin) are NOT
# stored here — they are Docker secret FILES in ./secrets/*.txt. Generate them
# with `npm run security:generate` (or `npm run setup`, which does everything).

# ---- Core ----
NODE_ENV=development
# Public origin the browser uses (dev = the Vite frontend). Drives CORS/CSP.
DOMAIN_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
# Sign-in cookies are Secure (SameSite=Strict, __Host- names) when DOMAIN_URL is https://,
# always in production; COOKIE_SECURE=true|false decides outside production.
# COOKIE_SECURE=

# ---- Host data volume paths ----
# Defaults live under ./data; point them at another disk to relocate storage.
POSTGRES_DATA_PATH=./data/postgres
UPLOADS_PATH=./data/uploads
BACKUPS_PATH=./data/backups
TEMP_PATH=./data/temp
LOGS_PATH=./data/logs

# ---- Auth / security ----
BCRYPT_ROUNDS=12
MIN_PASSWORD_LENGTH=12
# Passwords: at least MIN_PASSWORD_LENGTH characters (8..64), no composition rules unless
# REQUIRE_PASSWORD_COMPLEXITY=true. PASSWORD_BREACH_CHECK=true also refuses passwords found in
# known breaches (asks api.pwnedpasswords.com, sending only 5 hex digits of the hash).
REQUIRE_PASSWORD_COMPLEXITY=false
PASSWORD_BREACH_CHECK=false
# The general API rate limit is off by default in dev for convenience. Set to true to test it.
API_RATE_LIMITING=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
# Every backend setting, with its default, is in backend/src/config.ts; `npm run docs:env`
# in backend/ prints them as a table.

# ---- Passkeys (WebAuthn) — must match the origin you load in the browser ----
WEBAUTHN_RP_NAME=Nuggets
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ---- Optional integrations (leave blank if unused) ----
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=

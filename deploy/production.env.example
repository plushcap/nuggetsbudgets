# Nuggets — PRODUCTION deployment environment template.
#
# Copy to deploy/production.env and fill in. Used by deploy/deploy.sh, and a
# useful reference for the variables to set on a Portainer stack.
# NEVER commit your real production.env.
#
# Secrets (the DB and app DB passwords, JWT, session, CSRF and the data encryption key)
# are NOT stored here — they are Docker secret FILES in $SECRETS_BASE_PATH (the SMTP
# password and the SimpleFin connection are set up in the app). Create them
# with `./deploy/deploy.sh production setup`, or:
#   node scripts/generate-secrets.js --dir /opt/nuggets/secrets

# ---- Host paths (deploy.sh creates these) ----
DEPLOY_BASE_PATH=/opt/nuggets
SECRETS_BASE_PATH=/opt/nuggets/secrets
POSTGRES_DATA_PATH=/opt/nuggets/data/postgres
UPLOADS_PATH=/opt/nuggets/data/uploads
BACKUPS_PATH=/opt/nuggets/data/backups
TEMP_PATH=/opt/nuggets/data/temp
LOGS_PATH=/opt/nuggets/data/logs

# ---- deploy.sh backup ----
# How many of its own dumps `./deploy/deploy.sh production backup` keeps in BACKUPS_PATH:
# the newest (nuggets_backup_*.sql, unencrypted); 0 keeps every one. The app's own backups
# (*.enc, the Backup page) keep theirs for the days set there.
DEPLOY_BACKUP_KEEP=10

# ---- Container user IDs (deploy.sh gives them the paths above; these are the defaults) ----
NUGGETS_USER_ID=1001
POSTGRES_USER_ID=1999

# ---- Database ----
# Read when the database is first created (and then by the backend, the healthcheck and
# `deploy.sh backup`): change them before the first start only, since an existing
# database keeps the names it was made with. A new POSTGRES_USER also takes
# MIGRATION_DB_USER=<the same>: migrations and backups run as the owner.
POSTGRES_DB=nuggets_db
POSTGRES_USER=nuggetsApp_user

# ---- Public URL (must match your reverse-proxy domain) ----
DOMAIN_URL=https://nuggets.example.com
CLIENT_URL=https://nuggets.example.com

# ---- Ports ----
# What the backend and frontend listen on inside their containers, where the reverse
# proxy connects (nuggets_backend:5000, nuggets_frontend:3000); neither is published on
# the host. Change them only together with the proxy's upstreams.
BACKENDPORT=5000
FRONTENDPORT=3000
# Dozzle's port, published on the host (Portainer stack only).
DOZZLEPORT=3200

# ---- Runtime ----
# The containers run UTC whatever this says (the compose files pin TZ: UTC); set the
# household's time zone in General Settings instead.
TZ=UTC
RUN_MIGRATIONS=true
# How many proxies sit in front of the backend (true = 1, e.g. Caddy; 2 behind a CDN and Caddy),
# or their addresses/CIDR ranges. The sign-in rate limits key on the client address it yields.
TRUST_PROXY=true

# ---- Auth / security ----
BCRYPT_ROUNDS=12
MIN_PASSWORD_LENGTH=12
# Passwords: at least MIN_PASSWORD_LENGTH characters (8..64), no composition rules unless
# REQUIRE_PASSWORD_COMPLEXITY=true. PASSWORD_BREACH_CHECK=true also refuses passwords found in
# known breaches (asks api.pwnedpasswords.com, sending only 5 hex digits of the hash).
REQUIRE_PASSWORD_COMPLEXITY=false
PASSWORD_BREACH_CHECK=false
# The general API rate limit (always on in production).
API_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX_REQUESTS=500

# ---- Passkeys (WebAuthn) — must match DOMAIN_URL ----
WEBAUTHN_RP_NAME=Nuggets
WEBAUTHN_RP_ID=nuggets.example.com
WEBAUTHN_ORIGIN=https://nuggets.example.com
# required: passkeys must check a PIN or biometric. preferred: also security keys without a PIN.
WEBAUTHN_USER_VERIFICATION=required

# Every backend setting, with its default, is in backend/src/config.ts; `npm run docs:env`
# in backend/ prints them as a table. Sign-in limits, sessions, retention, pool size,
# shutdown, …
# Any of them set here (or in the Portainer stack) reaches the backend: both compose
# files pass each one. NODE_ENV and USE_DOCKER_SECRETS are fixed there.

# ---- Optional: OneDrive off-site backups ----
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=https://nuggets.example.com/api/onedrive/callback
